---
import Analytics from '@vercel/analytics/astro';

import Navigation from '@/components/Navigation';

import '@/styles/global.css';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
    <meta
      name="description"
      content="I make dance music for me and my friends"
    />
    <meta name="generator" content={Astro.generator} />
    <title>xfoxx</title>
    <Analytics />
  </head>
  <body class="bg-default text-xl text-default">
    <main>
      <slot />
    </main>
    <Navigation client:only="react" />
  </body>
</html>
