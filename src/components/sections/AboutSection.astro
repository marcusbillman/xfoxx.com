---
import { Image } from 'astro:assets';

import artistsImage from '@/assets/about-artists.jpg';
import bioImage from '@/assets/about-bio.jpg';
import gearImage from '@/assets/about-gear.jpg';
import nameImage from '@/assets/about-name.jpg';
import Question from '@/components/Question.astro';
---

<section
  id="about"
  class="grid scroll-m-16 grid-cols-1 border-t border-default md:grid-cols-[4rem_1fr_4rem]"
>
  {/* Left gutter */}
  <div
    class="hidden h-full items-center border-r border-default pt-12 pb-6 writing-vertical md:flex"
  >
    <h2 class="sticky top-22 text-subtle">ABOUT</h2>
  </div>
  {/* Center content */}
  <div class="">
    <h2 class="bg-subtle px-6 py-2 text-subtle md:hidden">ABOUT</h2>
    <Question question="A quick intro">
      <p>
        Hi! I'm <span class="text-accent">xfoxx</span>, a student, tech nerd,
        and bedroom producer.
      </p>
      <p>
        The stuff I make is mostly electronic with catchy melodies, crispy drum
        beats, and a bit of wonky sound design.
      </p>
      <p>
        I've been making music since I was little, uploading some of it to
        SoundCloud. In 2026, I decided to start releasing on streaming
        platforms, mainly to make it easier for my friends to find my music. I
        hope you like it! <span class="text-accent">:)</span>
      </p>
      <Image
        src={bioImage}
        alt="Compact MIDI keyboard, headphones, and a laptop"
        slot="image"
      />
    </Question>
    <Question question="My inspiration">
      <p>
        I love many kinds of music. Here are some of my favourite artists and
        influences:
      </p>
      <ul
        class="grid list-disc grid-cols-1 gap-x-6 pl-8 lg:list-none lg:grid-cols-2 lg:pl-0"
      >
        <li>
          <a
            href="https://open.spotify.com/artist/1vCWHaC5f2uS3yhpwWbIA6?si=UYq44izCQ9WkzpxJMjhIOA"
            target="_blank"
            rel="noopener noreferrer"
          >
            Avicii
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/35dxfY1wywqVRUEaVuMm13?si=cMSkRL9tQse-iWRjMramlg"
            target="_blank"
            rel="noopener noreferrer"
          >
            Bou
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/2N8IPNZTiNo3nj4mreOlHU?si=trhf9tMfThmIpny8COYnEg"
            target="_blank"
            rel="noopener noreferrer"
          >
            Camo & Krooked
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/3jNkaOXasoc7RsxdchvEVq?si=40e3c04e81ad4b0d"
            target="_blank"
            rel="noopener noreferrer"
          >
            Chase & Status
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/4uFZsG1vXrPcvnZ4iSQyrx?si=34aea694772e4553"
            target="_blank"
            rel="noopener noreferrer"
          >
            C418
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/3GEUIa3Z0Qlivy3EcJm5RX?si=675b93b10c9846ea"
            target="_blank"
            rel="noopener noreferrer"
          >
            Etherwood
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/2BQWHuvxG4kMYnfghdaCIy?si=049b5147129d440b"
            target="_blank"
            rel="noopener noreferrer"
          >
            Fox Stevenson
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/6nxWCVXbOlEVRexSbLsTer?si=c31ce289d18e4c0b"
            target="_blank"
            rel="noopener noreferrer"
          >
            Flume
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/4oLeXFyACqeem2VImYeBFe?si=7308e12e0bee44b1"
            target="_blank"
            rel="noopener noreferrer"
          >
            Fred again..
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/3yDDYheQFqfhKZXdjFQuuP?si=17988b3dfd3d46e8"
            target="_blank"
            rel="noopener noreferrer"
          >
            goddard.
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/2ZRQcIgzPCVaT9XKhXZIzh?si=48QhZrpoRBqGnregvBI45w"
            target="_blank"
            rel="noopener noreferrer"
          >
            Gryffin
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/05lF0DUkLJqiW5o70SScyR?si=b1aa8359bbd24496"
            target="_blank"
            rel="noopener noreferrer"
          >
            Hybrid Minds
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/45eNHdiiabvmbp4erw26rg?si=bdc1e7841b714bf1"
            target="_blank"
            rel="noopener noreferrer"
          >
            ILLENIUM
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/3Ww8GMbCDMAGwJJ2hd7z7z?si=gS8VrgveRy-B8CiD60Dz3w"
            target="_blank"
            rel="noopener noreferrer"
          >
            Lena Raine
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/3Ka3k9K2WStR52UJVtbJZW?si=bd186e5be2634bfa"
            target="_blank"
            rel="noopener noreferrer"
          >
            Mild Minds
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/4DpmPt7gfAAq7WEx0E1X8s?si=lAXc9m01RvGh2J9M27geDA"
            target="_blank"
            rel="noopener noreferrer"
          >
            piri
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/0jNDKefhfSbLR9sFvcPLHo?si=rXzdS2bYQ5-gRZqCx6wT3A"
            target="_blank"
            rel="noopener noreferrer"
          >
            San Holo
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/5he5w2lnU9x7JFhnwcekXX?si=afcfe30ff209420f"
            target="_blank"
            rel="noopener noreferrer"
          >
            Skrillex
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/4UWWa5dKgTLAx8mv6Ju6X1?si=791d8a549b5d4cf9"
            target="_blank"
            rel="noopener noreferrer"
          >
            venbee
          </a>
        </li>
        <li>
          <a
            href="https://open.spotify.com/artist/1L5GuSYb4gktP74dqFkJpi?si=c911132f9a1841cb"
            target="_blank"
            rel="noopener noreferrer"
          >
            Vibe Chemistry
          </a>
        </li>
      </ul>
      <Image
        src={artistsImage}
        alt="List of artists in my Spotify library"
        slot="image"
      />
    </Question>
    <Question question="Gear and software">
      <p>
        I use <a
          href="https://www.ableton.com/en/live/"
          target="_blank"
          rel="noopener noreferrer">Ableton Live</a
        > on my <span class="text-accent">MacBook Air (M2, 2022)</span>. Apart
        from the stock plugins, I really like
      </p>
      <ul
        class="grid list-disc grid-cols-1 gap-x-6 pl-8 lg:list-none lg:grid-cols-2 lg:pl-0"
      >
        <li>
          <a
            href="https://www.native-instruments.com/en/products/komplete/bundles/komplete-15-standard/"
            target="_blank"
            rel="noopener noreferrer">Komplete 15</a
          >
        </li>
        <li>
          <a
            href="https://www.arturia.com/products/software-instruments/v-collection/overview"
            target="_blank"
            rel="noopener noreferrer">V Collection 9</a
          >
        </li>
        <li>
          <a
            href="https://www.arturia.com/products/software-effects/fx-collection/overview"
            target="_blank"
            rel="noopener noreferrer">FX Collection 4</a
          >
        </li>
        <li>
          <a
            href="https://www.cableguys.com/shaperbox"
            target="_blank"
            rel="noopener noreferrer">ShaperBox 3</a
          >
        </li>
        <li>
          <a
            href="https://vital.audio/"
            target="_blank"
            rel="noopener noreferrer">Vital</a
          >
        </li>
        <li>
          <a
            href="https://kilohearts.com/products/kilohearts_essentials"
            target="_blank"
            rel="noopener noreferrer">Kilohearts Essentials</a
          >
        </li>
      </ul>
      <p>
        My main controllers are the
        <a
          href="https://www.arturia.com/products/hybrid-synths/minilab-3/overview"
          target="_blank"
          rel="noopener noreferrer">Arturia MiniLab 3</a
        > and <a
          href="https://www.ableton.com/en/push/"
          target="_blank"
          rel="noopener noreferrer">Ableton Push 2</a
        >. For audio, I use <a
          href="https://www.adam-audio.com/en/desktop/d3v/"
          target="_blank"
          rel="noopener noreferrer">Adam Audio D3V</a
        > monitors and <a
          href="https://www.beyerdynamic.com/products/dt-700-pro-x/"
          target="_blank"
          rel="noopener noreferrer">Beyerdynamic DT 700 PRO X</a
        > headphones connected to a <a
          href="https://focusrite.com/products/scarlett-2i2"
          target="_blank"
          rel="noopener noreferrer">Focusrite Scarlett 2i2</a
        >. My samples come from <a
          href="https://splice.com/"
          target="_blank"
          rel="noopener noreferrer">Splice</a
        > and I release through <a
          href="https://www.landr.com/digital-distribution"
          target="_blank"
          rel="noopener noreferrer">LANDR</a
        >.
      </p>
      <Image
        src={gearImage}
        alt="MIDI keyboard, microphone, and laptop"
        slot="image"
      />
    </Question>
    <Question question="Behind the name">
      <p>
        <span class="text-accent">xfoxx [eks-foks]</span> is a screen name I've used
        since I was a kid. 6-year-old me needed a username on his Nintendo DS Lite
        and caught a stroke of genius:
      </p>
      <ul class="list-disc pl-8">
        <li>Foxes are pretty cool</li>
        <li>X is a cool letter</li>
        <li>37 (?)</li>
      </ul>
      <p>
        <span class="text-accent">X-fox 37</span> it was. Luckily, I've cleaned up
        the spelling.
      </p>
      <Image
        src={nameImage}
        alt="The username settings screen on a Nintendo DS Lite"
        slot="image"
      />
    </Question>
  </div>
  {/* Right gutter */}
  <div class="hidden h-full border-l border-default md:block"></div>
</section>
