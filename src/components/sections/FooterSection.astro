---
import { Image } from 'astro:assets';

import gradient from '@/assets/rainbow-gradient.jpg';
import { Symbol } from '@/components/Logo';
---

<section
  id="contact"
  class="grid grid-cols-1 border-t border-default md:grid-cols-[4rem_1fr_4rem]"
>
  {/* Left gutter */}
  <div
    class="hidden h-full items-center justify-center border-r border-default writing-vertical md:flex"
  >
  </div>
  {/* Center content */}
  <div class="flex flex-col-reverse gap-12 pt-12 pb-16 md:flex-row md:py-16">
    <div>
      <div
        class="relative h-full w-fit overflow-hidden mask-[url(/xfoxx-symbol.svg)] bg-cover bg-center mask-contain mask-no-repeat"
      >
        <Symbol className="h-full opacity-0" />
        <Image
          src={gradient}
          alt=""
          class="absolute top-1/2 left-1/2 aspect-square w-[200%] max-w-none -translate-2/3 animate-[spin_10s_linear_infinite] object-cover"
        />
      </div>
    </div>
    <div class="px-6 md:pb-16">
      <p>
        Website designed and built with
        <span class="break-keep" aria-label="love and music">❤️🎹</span>
        by me.
      </p>
      <p class="text-subtle">&copy; 2025 xfoxx</p>
    </div>
  </div>
  {/* Right gutter */}
  <div class="hidden h-full border-l border-default md:block"></div>
</section>
