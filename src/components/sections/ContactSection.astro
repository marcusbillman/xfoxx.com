---
import CopyEmail from '../CopyEmail';
---

<section
  id="contact"
  class="grid grid-cols-1 border-t border-default md:grid-cols-[4rem_1fr_4rem]"
>
  {/* Left gutter */}
  <div
    class="hidden h-full items-center justify-center border-r border-default writing-vertical md:flex"
  >
    <h2 class="text-subtle">CONTACT</h2>
  </div>
  {/* Center content */}
  <div class="">
    <h2 class="bg-subtle px-6 py-2 text-subtle md:hidden">CONTACT</h2>
    <CopyEmail client:visible />
  </div>
  {/* Right gutter */}
  <div class="hidden h-full border-l border-default md:block"></div>
</section>
